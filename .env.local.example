# Copy this file to .env.local and fill in your values
# NEXT_PUBLIC_ prefix = exposed to browser (safe for non-secret values)
# No prefix = server-only (never sent to browser)

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SANITY_USE_CDN=true


# Server-only Google Apps Script web app URL for Service Growth Audit submissions
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Admin blog manager (/admin) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32

# Comma-separated Google accounts allowed into /admin
ADMIN_EMAILS=you@example.com

# Google OAuth credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sanity write token with Editor role (manage.sanity.io)
SANITY_API_TOKEN=

# --- Search engine verification (optional, set in Vercel) ---
# Google Search Console -> Add property -> HTML tag -> copy the content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> Add site -> Meta tag -> copy the content value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
